// ============================================================================
// RiskApproval — 风控审批通过
// ============================================================================
struct RiskApprovalTag {
    static constexpr std::string_view name = "risk.approval";

    struct Payload {
        StrategyId strategyId;
        SymbolCode symbol;
        OrderSide side{OrderSide::Buy};
        double price{0.0};
        std::int64_t quantity{0};
        double cashAmount{0.0};
        double signalStrength{1.0};
        CorrelationId correlationId;
    };

    static engine::EventFormat pack_to_format(const Payload& p) {
        engine::EventFormat f;
        f.type = std::string(name);
        f.set("strategy_id", p.strategyId.text());
        f.set("symbol", p.symbol.text());
        f.set("side", p.side == OrderSide::Buy ? "BUY" : "SELL");
        f.set("price", p.price);
        f.set("quantity", static_cast<std::int64_t>(p.quantity));
        if (p.cashAmount > 0.0) f.set("cash_amount", p.cashAmount);
        f.set("signal_strength", p.signalStrength);
        f.set("correlation_id", p.correlationId.text());
        return f;
    }

    static void unpack(const engine::EventFormat& f, Payload& p) {
        p.strategyId = StrategyId(f.get<std::string>("strategy_id").value_or(""));
        p.symbol = SymbolCode(f.get<std::string>("symbol").value_or(""));
        auto sideStr = f.get<std::string>("side").value_or("BUY");
        p.side = (sideStr == "SELL") ? OrderSide::Sell : OrderSide::Buy;
        p.price = f.get<double>("price").value_or(0.0);
        p.quantity = static_cast<std::int64_t>(f.get<double>("quantity").value_or(0.0));
        p.cashAmount = f.get<double>("cash_amount").value_or(0.0);
        p.signalStrength = f.get<double>("signal_strength").value_or(1.0);
        p.correlationId = CorrelationId(f.get<std::string>("correlation_id").value_or(""));
    }
};

using RiskApprovalEvent = StrongEvent<RiskApprovalTag>;

// ============================================================================
// RiskReject — 风控拒绝
// ============================================================================
struct RiskRejectTag {
    static constexpr std::string_view name = "risk.reject";

    struct Payload {
        CorrelationId correlationId;
        std::string reason;
        StrategyId strategyId;
        SymbolCode symbol;
    };

    static engine::EventFormat pack_to_format(const Payload& p) {
        engine::EventFormat f;
        f.type = std::string(name);
        f.set("correlation_id", p.correlationId.text());
        f.set("reason", p.reason);
        f.set("strategy_id", p.strategyId.text());
        f.set("symbol", p.symbol.text());
        return f;
    }

    static void unpack(const engine::EventFormat& f, Payload& p) {
        p.correlationId = CorrelationId(f.get<std::string>("correlation_id").value_or(""));
        p.reason = f.get<std::string>("reason").value_or("");
        p.strategyId = StrategyId(f.get<std::string>("strategy_id").value_or(""));
        p.symbol = SymbolCode(f.get<std::string>("symbol").value_or(""));
    }
};

using RiskRejectEvent = StrongEvent<RiskRejectTag>;

