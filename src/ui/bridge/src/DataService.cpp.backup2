    }
    
    // 4. 数据清洗配置
    if (rules.contains("dataCleaning")) {
        QVariantMap dataCleaningRule = rules["dataCleaning"].toMap();
        
        // 排除ST股票
        if (dataCleaningRule.contains("excludeST") && dataCleaningRule["excludeST"].toBool()) {
            DataCleaningEngine::CleaningRule rule(
                DataCleaningEngine::RULE_CUSTOM_FILTER,
                "排除ST股票",
                "过滤ST股票数据"
            );
            rule.parameters["excludeST"] = true;
            rule.enabled = true;
            cleaningRules.append(rule);
            qDebug() << "Added exclude ST stock rule";
        }
        
        // 排除停牌股票
        if (dataCleaningRule.contains("excludeSuspended") && dataCleaningRule["excludeSuspended"].toBool()) {
            DataCleaningEngine::CleaningRule rule(
                DataCleaningEngine::RULE_CUSTOM_FILTER,
                "排除停牌股票",
                "过滤停牌股票数据"
            );
            rule.parameters["excludeSuspended"] = true;
            rule.enabled = true;
            cleaningRules.append(rule);
            qDebug() << "Added exclude suspended stock rule";
        }
        
        // 缺失值处理策略
        if (dataCleaningRule.contains("missingValue")) {
            QString strategy = dataCleaningRule["missingValue"].toString();
            DataCleaningEngine::CleaningRule rule(
