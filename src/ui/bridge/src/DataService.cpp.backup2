                "缺失值处理策略",
                QString("缺失值处理: %1").arg(strategy)
            );
            rule.parameters["missingValueStrategy"] = strategy;
            rule.enabled = true;
            cleaningRules.append(rule);
            qDebug() << "Added missing value strategy rule:" << strategy;
        }
        
        // 异常值处理策略
        if (dataCleaningRule.contains("outliers")) {
            QString strategy = dataCleaningRule["outliers"].toString();
            DataCleaningEngine::CleaningRule rule(
                DataCleaningEngine::RULE_CUSTOM_FILTER,
                "异常值处理策略",
                QString("异常值处理: %1").arg(strategy)
            );
            rule.parameters["outlierStrategy"] = strategy;
            rule.enabled = true;
            cleaningRules.append(rule);
            qDebug() << "Added outlier strategy rule:" << strategy;
        }
    }
    
    // 5. 市场过滤
    if (rules.contains("market")) {
        QVariantMap marketRule = rules["market"].toMap();
        
        // A股过滤
        if (marketRule.contains("aShares") && marketRule["aShares"].toBool()) {
            DataCleaningEngine::CleaningRule rule(
                DataCleaningEngine::RULE_CUSTOM_FILTER,
                "A股过滤",
                "只保留A股数据"
            );
            rule.parameters["marketType"] = "A";
            rule.enabled = true;
            cleaningRules.append(rule);
            qDebug() << "Added A-share filter rule";
        }
        
        // 港股过滤
        if (marketRule.contains("hk") && marketRule["hk"].toBool()) {
            DataCleaningEngine::CleaningRule rule(
                DataCleaningEngine::RULE_CUSTOM_FILTER,
                "港股过滤",
                "只保留港股数据"
            );
            rule.parameters["marketType"] = "HK";
            rule.enabled = true;
            cleaningRules.append(rule);
            qDebug() << "Added HK-share filter rule";
        }
        
        // 美股过滤
        if (marketRule.contains("us") && marketRule["us"].toBool()) {
            DataCleaningEngine::CleaningRule rule(
                DataCleaningEngine::RULE_CUSTOM_FILTER,
                "美股过滤",
                "只保留美股数据"
            );
            rule.parameters["marketType"] = "US";
            rule.enabled = true;
            cleaningRules.append(rule);
            qDebug() << "Added US-share filter rule";
        }
    }
    
    // 6. 如果没有添加任何规则，添加默认完整性检查规则
    if (cleaningRules.isEmpty()) {
        qDebug() << "No specific rules found, adding default completeness check";
        DataCleaningEngine::CleaningRule rule(
            DataCleaningEngine::RULE_COMPLETENESS_CHECK,
            "完整性检查",
            "检查数据字段完整性"
        );
        rule.parameters["requiredFields"] = QStringList{"symbol", "date", "open", "high", "low", "close", "volume"};
        rule.enabled = true;
        cleaningRules.append(rule);
    }
    
    qDebug() << "Converted" << cleaningRules.size() << "cleaning rules";
    return cleaningRules;
}
